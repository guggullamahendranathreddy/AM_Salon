# ==============================================================================
# AM UNISEX SALON - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development or configure in Vercel Project Settings
# ==============================================================================

# 1. REAL DATABASE (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/am_salon?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/am_salon?retryWrites=true&w=majority"

# 2. REAL AUTHENTICATION (JWT Secret for signing admin sessions)
# Generate a strong 32+ character random string
JWT_SECRET="your-super-secret-jwt-token-key-change-this-in-production"

# 3. INITIAL ADMIN SEED CREDENTIALS (Used by: npm run seed:admin)
ADMIN_NAME="AM Salon Administrator"
ADMIN_EMAIL="admin@amsalon.com"
ADMIN_PASSWORD="your-secure-admin-password-here"

# 4. CLOUD IMAGE STORAGE (Cloudinary)
# Obtain from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 5. SERVER & APP URL
PORT=3000
APP_URL="https://amunisexsalon.vercel.app"
